# Copy this file to .env and fill it in. Never commit .env.

# From the Discord Developer Portal > your app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional
PORT=3000
DB_FILE=crossword.db

# DEV ONLY: play in a normal browser tab as a fake user (http://localhost:3000/?user=alice).
# Only works together with `npm run dev`; `npm start` ignores it.
DEV_FAKE_USER=1
